{
  "name": "hatch-ts-space-gtd",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "check:local-config": "bun ./scripts/check-local-config.ts",
    "typecheck": "bun run check:local-config && bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "test:mounted": "bun test client/tests/mounted-workspace.test.tsx",
    "build": "bun run check:local-config && bun run test:mounted && bun run build:server && bun run build:client",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "build:client": "bun ./client/build.mjs",
    "db:migrate": "bun scripts/migrate.ts",
    "build:standalone": "bun scripts/build-client-standalone.mjs",
    "serve:standalone": "bun scripts/serve-standalone.ts"
  },
  "dependencies": {
    "@hatch/space-sdk": "file:./vendor/space-sdk-shim",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.0.15",
    "happy-dom": "^20.14.5",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  }
}
