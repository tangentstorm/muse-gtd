{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "bun-types"
    ],
    "outDir": "./dist",
    "rootDir": ".",
    "tsBuildInfoFile": "./.tsbuildinfo.server",
    "paths": {
      "@space/privileged": [
        "./.generated/privileged.contract.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    ".generated/**/*"
  ]
}